{% extends 'base.html.twig' %}

{% block title %}Ajouter un événement{% endblock %}

{% block body %}
    <div class="narrow">
        <a class="back-link" href="{{ path('app_home') }}">← Retour aux événements</a>

        <div class="card">
            <h1>Ajouter un événement</h1>
            <p class="muted">Votre événement sera visible après validation par un administrateur.</p>

            {{ form_start(eventForm, {'attr': {'class': 'form'}}) }}

                {{ form_errors(eventForm) }}

                {{ form_row(eventForm.titre, {
                    'label': 'Titre',
                    'attr': {'placeholder': 'Ex. : Soirée jazz au Kiosque'}
                }) }}

                {{ form_row(eventForm.date, {
                    'label': 'Date',
                    'type': 'datetime-local'
                    }) }}

                {{ form_row(eventForm.informations, {
                    'label': 'Informations',
                    'attr': {'placeholder': 'Lieu, programme, tarif...'}
                    }) }}

                {{ form_row(eventForm.categorie, {
                    'label': 'Catégorie',
                    'attr': {'placeholder': 'Ex. : Concert, Conférence, Atelier, Sport'}
                    }) }}

                {{ form_row(eventForm.place_number, {
                    'label': 'Nombre de places',
                    'attr': {'min': 1, 'value': 20}
                }) }}

                {{ form_row(eventForm.picture, {
                    'label': 'Image à la une',
                    'help': 'JPG, PNG ou WebP.',
                    'help_attr': {'class': 'help-text'}
                    }) }}

                {{ form_row(eventForm.submit, {
                    'label': "Enregistrer l'événement"
                }) }}

            {{ form_end(eventForm) }}
        </div>
    </div>
{% endblock %}
