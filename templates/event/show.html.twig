{% extends 'base.html.twig' %}

{% block title %}{{ evenement.titre }}{% endblock %}

{% block body %}
    <a class="back-link" href="{{ path('app_home') }}">
        Retour aux événements
    </a>

    <article class="cat-{{ evenement.categorie.value }}">
        <header class="detail-hero" style="<img src="{{ asset(evenement.picture) }}" alt="{{ evenement.titre }}">">
            <div class="detail-hero-content">
                <span class="badge">
                    {{ evenement.categorie.value|capitalize }}
                </span>

                <h1>{{ evenement.titre }}</h1>
                <p>{{ evenement.date|date('d/m/Y à H:i') }}</p>
            </div>
        </header>

        <div class="detail-grid">
            <section class="card">
                <h2>Informations</h2>
                <p>{{ evenement.informations|nl2br }}</p>
            </section>

            <aside class="card booking">
                <p class="places">
                    <strong>{{ evenement.placeNumber }}</strong> places au total
                </p>
                {# Variante quand l'utilisateur est déjà inscrit :
                <p class="muted">Vous êtes inscrit à cet événement.</p>
                <form method="post">
                    <button type="submit" class="btn btn-secondary btn-block">Se désinscrire</button>
                </form>
                #}

                {# Variante quand l'événement est complet :
                <p class="places"><span class="badge badge-full">Complet</span></p>
                <button class="btn btn-block" disabled>Complet</button>
                #}

                {# Variante quand l'utilisateur n'est pas connecté :
                <a class="btn btn-block" href="{{ path('app_login') }}">Connectez-vous pour vous inscrire</a>
                #}
            </aside>
        </div>
    </article>
{% endblock %}
