{% extends 'base.html.twig' %}

{% block title %}Validation des événements{% endblock %}

{% block body %}
    <div class="section-head">
        <div>
            <h1>Événements à valider</h1>
            <p class="muted">{{ evenements|length }} événements en attente de validation.</p>
        </div>
    </div>

    <div class="card table-wrap">
        <table class="table">
            <thead>
                <tr>
                    <th>Événement</th>
                    <th>Date</th>
                    <th>Catégorie</th>
                    <th>Places</th>
                    <th>Statut</th>
                    <th></th>
                </tr>
            </thead>
                <tbody>
                    {% for evenement in evenements %}
                        <tr>
                            <td>
                                <a href="{{ path('app_event_show', {id: evenement.id}) }}">
                                    {{ evenement.titre }}
                                </a>
                            </td>

                            <td>{{ evenement.date|date('d/m/Y à H:i') }}</td>

                            <td>
                                <span class="badge cat-{{ evenement.categorie.value }}">
                                    {{ evenement.categorie.value|capitalize }}
                                </span>
                            </td>

                            <td>{{ evenement.placeNumber }}</td>

                            <td>
                                <span class="badge badge-pending">Non validé</span>
                            </td>

                            <td>
                                <form method="post"
                                    action="{{ path('app_event_validate', {id: evenement.id}) }}">
                                <input
                                    type="hidden"
                                    name="_token"
                                    value="{{ csrf_token('validate_event_' ~ evenement.id) }}"
                                >

                                <button type="submit" class="btn btn-small btn-success">
                                    Valider
                                </button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6">Aucun événement en attente.</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
